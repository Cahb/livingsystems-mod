<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>LivingSystems</RootNamespace>
    <!-- Empyrion's Managed folder, mounted read-only by run.sh -->
